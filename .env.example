# Variables de entorno del proyecto.
#
# Para desarrollo: copiá este archivo a .env.local y completá los valores.
#   cp .env.example .env.local
# En producción (Vercel) se configuran desde el dashboard del proyecto.
# Ninguna de estas claves se commitea: .gitignore excluye .env* (salvo este ejemplo).

# --- Imágenes OG (app/api/og) ---------------------------------------------
# Secreto HMAC para firmar las URLs de las imágenes OG y evitar generación
# arbitraria. Requerida en producción; en desarrollo, si falta, se usa un
# secreto de dev con un warning en consola.
OG_SECRET=

# --- Likes y vistas (lib/redis.ts, lib/ratelimit.ts) -----------------------
# Credenciales de Upstash Redis. Opcionales: sin ellas, likes y vistas quedan
# deshabilitadas con un aviso en consola.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Prefijo de claves Redis. Obligatoria solo si Redis está configurado:
# 'prod' en Production, 'nonprod' en Preview/Development.
REDIS_ENV_TAG=nonprod
# Salt para hashear IPs en likes/vistas (lib/hash.ts). Requerida por esas
# rutas API; cualquier string aleatorio largo sirve en desarrollo.
IP_HASH_SALT=

# --- Tablero privado de lectura (app/stats) --------------------------------
# Secreto compartido para abrir /stats?key=... , donde se ven vistas, lecturas
# y read-through de cada pieza. Sin esta variable la ruta responde 404, que es
# el default deseado: preferible que no exista a que quede abierta.
STATS_KEY=

# --- Stats de la home (lib/github.ts, lib/leetcode.ts) ---------------------
# Opcionales: sin estos valores, las tarjetas de stats muestran estado vacío.
GITHUB_USERNAME=
GITHUB_TOKEN=
LEETCODE_USERNAME=

# --- Sitio ------------------------------------------------------------------
# URL pública del sitio (sitemap, URLs absolutas de OG, IndexNow).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clave de IndexNow (scripts/indexnow.mjs y workflow de CI). Opcional en local.
INDEXNOW_KEY=

# --- Analytics de producto (PostHog) ----------------------------------------
# Clave PÚBLICA del proyecto (phc_...). Viaja en el bundle del navegador, así
# que no es un secreto: la clave personal (phx_...) nunca va acá ni al cliente.
# Sin esta variable, `lib/analytics.ts` queda en no-op y no se manda nada: en
# local no se ensucia el proyecto con eventos de desarrollo.
# Los eventos salen por /rl, el proxy inverso definido en next.config.ts.
NEXT_PUBLIC_POSTHOG_KEY=
